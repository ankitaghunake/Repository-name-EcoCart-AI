{
  "manifest_version": 3,
  "name": "EcoCart AI - Local Development",
  "version": "1.2.0",
  "description": "Analyze shopping-cart products and compare them with sustainable catalog alternatives.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:"
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Check sustainability", "default_popup": "popup.html" },
  "options_page": "options.html"
}